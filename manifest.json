{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/JiuLiangG/pep-list-migrator",
  "default_locale": "en",
  "permissions": ["cookies", "downloads", "storage"],
  "host_permissions": [
    "https://pep-web.org/*",
    "https://pads.pep-web.org/*",
    "https://api.pep-web.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_extName__"
  },
  "content_scripts": [
    {
      "matches": ["https://pep-web.org/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pep-web.org/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
